# --- Las pruebas simuladas -------------------------------------------------------------------
# --rerun obliga a correr las pruebas aunque nada haya cambiado: así el resultado es de ESTA corrida.
marca=$(mktemp)
salida=$(mktemp)
echo "Corriendo las pruebas… (la primera vez tarda y necesita red para bajar librerías)"
"./$PROY/gradlew" -p "$PROY" -q testDebugUnitTest --rerun >"$salida" 2>&1
rc=$?

TODOS=("$XMLG" "$XMLR" "$XMLA" "$XMLM" "$XMLRM" "$XMLAM")
frescos=1
for x in "${TODOS[@]}"; do
  { [ -f "$x" ] && [ "$x" -nt "$marca" ]; } || frescos=0
done
if [ "$frescos" -ne 1 ]; then
  no "Las pruebas no llegaron a correr. Esto dijo Gradle:"
  grep -E '^e: |error:|What went wrong|SDK location|Java heap|No matching client found|google-services.json is missing|Could not (find|resolve)' "$salida" \
    | sed -e 's|file://.*/||' -e 's| in /.*google-services.json| en tu app/google-services.json|' | head -8 | sed 's/^/     /'
  if grep -q 'google-services.json is missing' "$salida"; then
    nota "Con el plugin aplicado, el proyecto no compila sin app/google-services.json: es el de TU proyecto de Firebase (lección 03)"
  fi
  nota "Para ver todo:  ./$PROY/gradlew -p $PROY testDebugUnitTest"
  rm -f "$marca" "$salida"
  echo; echo "Resultado: 0 pruebas corridas."; exit 1
fi
rm -f "$marca" "$salida"

# El conteo se lee de los informes de resultados (XML), no del código de salida de Gradle.
# Son seis informes, uno por clase de pruebas, y se suman.
attr() { sed -n 's/.*<testsuite [^>]*[[:space:]]'"$1"'="\([0-9]*\)".*/\1/p' "$2" | head -1; }
suma() { a="$1"; shift; t=0; for x in "$@"; do v=$(attr "$a" "$x"); t=$((t + ${v:-0})); done; echo "$t"; }
total=$(suma tests "${TODOS[@]}"); fallas=$(suma failures "${TODOS[@]}")
errores=$(suma errors "${TODOS[@]}"); saltadas=$(suma skipped "${TODOS[@]}")
verdes=$((total - fallas - errores - saltadas))

# estado <nombre de la prueba> <informe> → paso | fallo | falta
estado() {
  awk -v n="$1" '
    /<testcase / { enc = (index($0, "name=\"" n "\"") > 0); if (enc) { visto = 1; if ($0 ~ /\/>[[:space:]]*$/) { print "paso"; fin = 1; exit } } next }
    enc && /<(failure|error|skipped)/ { print "fallo"; fin = 1; exit }
    enc && /<\/testcase>/ { print "paso"; fin = 1; exit }
    END { if (!fin) print (visto ? "fallo" : "falta") }' "$2"
}
# todas <informe> <prueba>… → cuántas de esas pruebas pasaron
todas() { x="$1"; shift; n=0; for p in "$@"; do [ "$(estado "$p" "$x")" = "paso" ] && n=$((n + 1)); done; echo "$n"; }
revisa() { # informe · nombre · qué demostró · qué falta
  case "$(estado "$2" "$1")" in
    paso)  si "$3" ;;
    fallo) no "$4" ;;
    *)     no "La prueba $2 no corrió: revisa que el archivo de pruebas esté completo" ;;
  esac
}

# --- Lo de la lección 04 sigue en verde -------------------------------------------------------
t04=$(suma tests "$XMLG" "$XMLR" "$XMLA")
m04=$(( $(suma failures "$XMLG" "$XMLR" "$XMLA") + $(suma errors "$XMLG" "$XMLR" "$XMLA") + $(suma skipped "$XMLG" "$XMLR" "$XMLA") ))
if [ "$t04" -eq 20 ] && [ "$m04" -eq 0 ]; then
  si "Simulado: las 20 pruebas de la lección 04 siguen en verde (10 de EntradaConGoogleTest, 8 de RecorridoTest y 2 de ArranqueTest): las pantallas y el botón de Google no cambiaron para ellas"
else
  no "De las 20 pruebas de la lección 04 hay $((t04 - m04)) en verde de $t04 corridas: esta lección no debía cambiar las pantallas ni el botón de Google. Corre  ./$PROY/gradlew -p $PROY testDebugUnitTest"
fi

# --- 5.2 · Los dos botones conviven -----------------------------------------------------------
bot=$(todas "$XMLRM" losDosBotonesEstanYCadaUnoLlamaASuEntrada sinEntradaDeMicrosoftLaPantallaEsLaDeLaLeccion04)
arr=$(todas "$XMLAM" laAppArrancadaMuestraLosDosBotones)
if [ "$bot" -eq 2 ] && [ "$arr" -eq 1 ]; then
  si "Simulado: los dos botones conviven — están los dos, cada uno llama a su entrada, y la app abierta desde MainActivity los muestra (3 de 3)"
else
  no "Los dos botones: $((bot + arr)) de 3 pruebas en verde. Una de ellas toca «Entrar con Microsoft» y espera el mensaje de la colisión: sigue roja hasta que tu EntradaConMicrosoft la reconozca (pasos 4 y 5). PantallaEntrada.kt y Tienda.kt vienen dados"
fi

# --- 5.2 · Qué le pide tu entrada al navegador ------------------------------------------------
case "$(estado pideElProveedorMicrosoft "$XMLM")" in
  paso) si "Simulado: un toque abre el navegador una sola vez, con el proveedor microsoft.com" ;;
  fallo)
    fue=$(awk '/name="pideElProveedorMicrosoft"/{e=1} e && /y fue /{print; exit}' "$XMLM" | sed -n 's/.*y fue \([A-Za-z0-9.]*\).*/\1/p')
    if [ -n "$fue" ]; then
      no "Tu entrada pidió otro proveedor: la solicitud llevó $fue y debe llevar microsoft.com (paso 4)"
    else
      no "Tu entrada todavía no abre el navegador con el proveedor microsoft.com, o lo abre más de una vez (paso 4)"
    fi ;;
  *) no "La prueba pideElProveedorMicrosoft no corrió: revisa que EntradaConMicrosoftTest.kt esté completo" ;;
esac
revisa "$XMLM" elNombreLoPoneElNavegador \
  "Simulado: el nombre es el que contesta la puerta del navegador" \
  "El nombre con el que contesta tu entrada no es el que entregó la puerta del navegador (paso 4)"
revisa "$XMLAM" laAppArmaSuEntradaConMicrosoftPidiendoEseProveedor \
  "Simulado: la entrada que arma MainActivity.crearEntradaConMicrosoft, con la puerta de mentira, pide microsoft.com" \
  "La entrada que arma MainActivity.crearEntradaConMicrosoft no abre el navegador con microsoft.com: debe regresar EntradaConMicrosoft(navegador) (paso 4)"
revisa "$XMLRM" conMicrosoftLlegaAlInicioConElNombre \
  "Simulado: con la puerta de mentira, tocar «Entrar con Microsoft» lleva al inicio con el nombre («Hola, Ana»)" \
  "Con la puerta de mentira, tocar «Entrar con Microsoft» no llega al inicio con el nombre (paso 4)"

# --- 5.2 · Retomar lo que quedó a medias ------------------------------------------------------
case "$(estado retomarConPendienteContestaQuienEntro "$XMLM")" in
  paso) si "Simulado: con una entrada a medias, retomar() regresa quién entró, sin abrir el navegador" ;;
  fallo) no "Tu entrada no retoma: $MARCA_ROMPE (paso 4)" ;;
  *) no "La prueba retomarConPendienteContestaQuienEntro no corrió: revisa que EntradaConMicrosoftTest.kt esté completo" ;;
esac
ret=$(todas "$XMLM" retomarSinPendienteContestaNullYNoAbreNada alTocarElBotonPrimeroPreguntaPorLoPendiente \
  loPendienteQueTerminoEnColisionSeRetomaComoColision loPendienteQueTerminoEnFallaSeRetomaComoFallo)
[ "$ret" -eq 4 ] \
  && si "Simulado: sin nada a medias retomar() regresa null; el botón pregunta primero por lo pendiente y no vuelve a abrir el navegador; y lo pendiente que terminó en colisión o en falla se retoma con ese resultado (4 de 4)" \
  || no "Retomar: $ret de 4 pruebas en verde. Revisa retomar(), que entrar() pregunte primero por lo pendiente, y que las fallas de lo pendiente se traduzcan igual que las del botón (pasos 4 y 5)"
abr=$(todas "$XMLRM" alAbrirConUnaEntradaAMediasLlegaAlInicioSinTocarNada alAbrirSinNadaAMediasSeQuedaEnLaBienvenida \
  alAbrirConUnaEntradaAMediasQueTerminoEnColisionMuestraSuMensaje)
[ "$abr" -eq 3 ] \
  && si "Simulado: al dibujarse la app, con una entrada a medias llega al inicio sin tocar nada; sin ella se queda en la bienvenida; y si terminó en colisión muestra su mensaje (3 de 3). Lo «a medias» lo dijo el doble: ninguna prueba cerró la app" \
  || no "Al abrir la app: $abr de 3 pruebas en verde. Tienda.kt viene dado y llama a retomar(): revisa lo que regresa (paso 4)"

# --- 5.2 · Las formas de no entrar: cada una con su resultado y su mensaje --------------------
caso() { # nombre del caso · pasaron de tu entrada · de cuántas · pasó la de la pantalla (0 o 1) · qué atrapar
  if [ "$2" -eq "$3" ] && [ "$4" -eq 1 ]; then
    si "Simulado: $1 — tu entrada contesta su propio resultado y la pantalla muestra su mensaje, sin pasar al inicio ($(($2 + $4)) de $(($3 + 1)))"
  elif [ "$2" -eq "$3" ]; then
    no "$1: tu entrada contesta bien su resultado ($2 de $3), pero la pantalla no muestra su mensaje. Tienda.kt viene dado y no se cambia"
  else
    no "$1: $(($2 + $4)) de $(($3 + 1)) pruebas en verde. Falta reconocer $5 y contestar su resultado (paso 5)"
  fi
}
caso "cancelación (FirebaseAuthWebException con ERROR_WEB_CONTEXT_CANCELED)" \
  "$(todas "$XMLM" laCancelacionContestaCancelada)" 1 "$(todas "$XMLRM" laCancelacionMuestraSuMensajeYNoPasa)" \
  "FirebaseAuthWebException con el código ERROR_WEB_CONTEXT_CANCELED"
caso "colisión de cuenta (FirebaseAuthUserCollisionException con ERROR_ACCOUNT_EXISTS_WITH_DIFFERENT_CREDENTIAL)" \
  "$(todas "$XMLM" laColisionContestaCuentaConOtroProveedor)" 1 "$(todas "$XMLRM" laColisionMuestraSuMensajeYNoPasa)" \
  "FirebaseAuthUserCollisionException con ese código"
revisa "$XMLM" otraColisionQueNoEsDeProveedorContestaFallo \
  "Simulado: una colisión con otro código (la cuenta ya es de otro usuario) contesta el error, no «entra con el otro botón»" \
  "Una colisión con otro código se está contando como «ese correo ya entró con otro botón»: no basta la clase, revisa también el código ERROR_ACCOUNT_EXISTS_WITH_DIFFERENT_CREDENTIAL (paso 5)"
caso "error (otra falla web que no es cancelación, u otra excepción)" \
  "$(todas "$XMLM" otraFallaDelNavegadorContestaFalloYNoCancelada cualquierOtraFallaContestaFallo)" 2 \
  "$(todas "$XMLRM" elErrorMuestraSuMensajeYNoPasa)" "cualquier otra excepción (también una falla web que no sea cancelación)"
revisa "$XMLRM" elMensajeDeLaColisionEsElDeLaLeccionYDistintoDeLosOtrosTres \
  "Simulado: el mensaje de la colisión es el de la lección y es distinto de los otros tres" \
  "El mensaje de la colisión ya no es el de la lección o es igual a otro: Tienda.kt viene dado y no se cambia"

[ "$total" -eq 44 ] || no "Esperaba 44 pruebas (20 de la lección 04; 12 de EntradaConMicrosoftTest, 10 de RecorridoConMicrosoftTest y 2 de ArranqueConMicrosoftTest) y los informes traen $total"
[ "$rc" -eq 0 ] || [ $((fallas + errores)) -gt 0 ] || no "Gradle terminó con error sin pruebas en rojo: corre  ./$PROY/gradlew -p $PROY testDebugUnitTest"

# --- «Rompe uno a propósito» · presencia mínima de la evidencia escrita ----------------------
if [ "$PROY" = "inicio" ]; then
  if [ -f "$RESP" ] && grep -qF "$MARCA_ROMPE" "$RESP"; then
    si "Escrito: respuestas/05.md trae pegado el rojo del «Rompe uno a propósito» (solo busco esa línea: no sé si lo rompiste ni califico tu explicación)"
  else
    no "respuestas/05.md no trae pegado el rojo del «Rompe uno a propósito» (paso 6): la línea que contiene «$MARCA_ROMPE»"
  fi
else
  nota "Lo escrito en respuestas/05.md solo se busca sobre inicio/"
fi

# --- Nivel instrumentado (solo si lo pides) ------------------------------------------------
# Corre dentro de Android. El conteo se lee del informe (XML) que deja Gradle, no de su código de salida.
linea_inst=""
if [ "$NIVEL" = "instrumentado" ]; then
  echo "Nivel instrumentado: pruebas dentro de Android, con las puertas de mentira"
  ADB="${ANDROID_HOME:+$ANDROID_HOME/platform-tools/adb}"
  [ -n "$ADB" ] && [ -x "$ADB" ] || ADB="$(command -v adb || true)"
  listos=0
  [ -n "$ADB" ] && listos=$("$ADB" devices 2>/dev/null | awk 'NR > 1 && $2 == "device"' | wc -l | tr -d ' ')
  if [ "$listos" -lt 1 ]; then
    no "Instrumentado: no hay ningún emulador abierto ni teléfono conectado (adb devices no lista ninguno en estado «device»): no se corrió"
    linea_inst="Instrumentado: 0 pruebas corridas (sin dispositivo)."
  else
    DIRI="$PROY/app/build/outputs/androidTest-results/connected/debug"
    marca=$(mktemp); salida=$(mktemp)
    echo "Corriendo las pruebas instrumentadas… (instala la app y su app de pruebas en el dispositivo)"
    "./$PROY/gradlew" -p "$PROY" -q connectedDebugAndroidTest >"$salida" 2>&1
    rci=$?
    # El informe se llama como el dispositivo (trae espacios): se toma el más nuevo que sea de ESTA corrida.
    xmli=""
    for x in "$DIRI"/TEST-*.xml; do
      [ -f "$x" ] && [ "$x" -nt "$marca" ] && xmli="$x"
    done
    if [ -z "$xmli" ]; then
      no "Instrumentado: las pruebas no llegaron a correr. Esto dijo Gradle:"
      grep -E '^e: |error:|What went wrong|No connected devices|INSTALL_FAILED|Could not (find|resolve)' "$salida" | head -6 | sed 's/^/     /'
      nota "Para ver todo:  ./$PROY/gradlew -p $PROY connectedDebugAndroidTest"
      linea_inst="Instrumentado: 0 pruebas corridas."
    else
      # Este informe trae un bloque <testsuite> por clase de pruebas (aquí, dos): se suman todos.
      # Leer solo el primero daría 4 donde corrieron 9 (medido el 18-nov-2026).
      attr_i() { sed -n 's/.*<testsuite [^>]*[[:space:]]'"$1"'="\([0-9]*\)".*/\1/p' "$2" | awk '{ t += $1 } END { print t + 0 }'; }
      it=$(attr_i tests "$xmli"); ifa=$(attr_i failures "$xmli"); ie=$(attr_i errors "$xmli"); isk=$(attr_i skipped "$xmli")
      revisa "$xmli" enAndroidConMicrosoftLlegaAlInicioConElNombre \
        "Instrumentado: dentro de Android, con la puerta de mentira, tocar «Entrar con Microsoft» lleva al inicio con el nombre, y la solicitud llevó microsoft.com" \
        "Dentro de Android, con la puerta de mentira, tocar «Entrar con Microsoft» no llega al inicio con el nombre (paso 4)"
      casos_i=$(todas "$xmli" enAndroidConMicrosoftLaCancelacionMuestraSuMensajeYNoPasa enAndroidConMicrosoftElErrorMuestraSuMensajeYNoPasa enAndroidConMicrosoftLaColisionMuestraSuMensajeYNoPasa)
      [ "$casos_i" -eq 3 ] \
        && si "Instrumentado: dentro de Android, cancelación, error y colisión muestran cada uno su mensaje sin pasar al inicio (3 de 3)" \
        || no "Dentro de Android, de cancelación, error y colisión solo $casos_i muestran su mensaje sin pasar al inicio (paso 5)"
      revisa "$xmli" enAndroidAlAbrirConUnaEntradaAMediasLlegaAlInicioSinTocarNada \
        "Instrumentado: dentro de Android, con una entrada a medias que contesta el doble, la app llega al inicio sin tocar nada (Android no cerró ninguna app)" \
        "Dentro de Android, con una entrada a medias que contesta el doble, la app no llega al inicio (paso 4)"
      # El botón de Google se cuenta por su clase de pruebas, no por nombre.
      g_tot=$(grep -c 'classname="'"$PAQ"'.BotonEnAndroidTest"' "$xmli")
      g_mal=$(awk '/<testcase /{e = (index($0, "BotonEnAndroidTest\"") > 0)} e && /<(failure|error|skipped)/{n++; e = 0} END{print n + 0}' "$xmli")
      if [ "$g_tot" -eq 4 ] && [ "$g_mal" -eq 0 ]; then
        si "Instrumentado: dentro de Android, las 4 pruebas del botón de Google de la lección 04 siguen en verde"
      else
        no "Dentro de Android, de las 4 pruebas del botón de Google de la lección 04 hay $((g_tot - g_mal)) en verde de $g_tot corridas"
      fi
      [ "$it" -eq 9 ] || no "Esperaba 9 pruebas instrumentadas (5 de MicrosoftEnAndroidTest y 4 de BotonEnAndroidTest) y el informe trae $it"
      [ "$rci" -eq 0 ] || [ $((ifa + ie)) -gt 0 ] || no "Gradle terminó con error sin pruebas instrumentadas en rojo: corre  ./$PROY/gradlew -p $PROY connectedDebugAndroidTest"
      linea_inst="Instrumentado: $((it - ifa - ie - isk)) de $it pruebas en verde ($ifa en rojo, $ie con error, $isk saltadas), leído de $xmli"
    fi
    rm -f "$marca" "$salida"
  fi
fi

echo
echo "Resultado: $verdes de $total pruebas en verde ($fallas en rojo, $errores con error, $saltadas saltadas), leído de"
for x in "${TODOS[@]}"; do echo "  $x"; done
if [ -n "$linea_inst" ]; then
  echo "$linea_inst"
  nota "Nivel instrumentado: demuestra que las pantallas, el toque y tu EntradaConMicrosoft funcionan dentro de Android."
  nota "  La puerta también era de mentira ahí: no se abrió el navegador ni se habló con Microsoft o con Firebase."
else
  nota "El nivel instrumentado no se corrió. Con un emulador abierto:  ./verifica $PROY instrumentado"
fi
nota "Nivel simulado: demuestra qué le pide tu EntradaConMicrosoft a la puerta del navegador (el proveedor), que"
nota "  pregunta por lo pendiente antes de abrirlo, y qué resultado y qué mensaje da cada caso."
nota "La puerta era de mentira. No se abrió ningún navegador, no se le pidió nada a Microsoft y Firebase no creó"
nota "  ningún usuario. De la puerta de verdad solo corrió la pregunta por lo pendiente, que aquí contesta «nada»."
nota "«Retomar» fue el doble diciendo que quedó algo a medias: ninguna prueba cerró la app con el navegador abierto."
nota "No demuestra que tu app esté registrada en Entra, que la dirección de retorno sea la exacta, que la clave"
nota "  que guardaste en Firebase sea la vigente ni que puedas entrar. Eso lo demuestra el nivel real (paso 9)."
nota "Las marcas «Clave:» leen archivos de $PROY/ y respuestas/05.md con una forma y un nombre: no ven tu terminal,"
nota "  tus capturas ni el historial de git, y una clave con otra forma se les pasa. No es un escaneo de secretos."
nota "Las marcas «Texto:» son estructura mínima, no evidencia de integración: buscan palabras y no validan que el código haga lo que dicen."
nota "  Que la app instalada use tus piezas lo respalda que MainActivity.kt sea el de la lección (sobre inicio/) y, al final, el nivel real."
nota "No califica tu tabla del registro (5.1), tu tabla de comparación (5.3) ni tu lista del 5.4: compáralas con «Compara tus respuestas»."
exit $ok
