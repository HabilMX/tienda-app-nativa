  done
  if [ -z "$cambiados" ]; then
    si "Andamiaje: las pruebas de esta lección, sus dobles, PuertaDelNavegador.kt, PantallaEntrada.kt, Tienda.kt, MainActivity.kt y Entrada.kt son los de la lección, sin cambios (13 archivos comparados). Con MainActivity.kt idéntico, onCreate le pasa a Tienda lo que arma Armado.kt"
  else
    no "Estos archivos ya no son iguales en inicio/ y en solucion/, y no se tocan:$cambiados"
    nota "Mira qué cambió con  git diff -- <archivo>  y deshazlo a mano. Restaurar con git descarta lo que tenga: revisa el diff antes."
  fi
fi

# Lo de la lección 04, comparado contra SU solución: así «no cambió» no depende de esta lección.
if [ -f "$L04/$DIRM/Puertas.kt" ]; then
  cambiados=""
  for t in "$DIRP/EntradaConGoogleTest.kt" "$DIRP/RecorridoTest.kt" "$DIRP/ArranqueTest.kt" \
           "$DIRP/EntradaFalsa.kt" "$DIRP/Dobles.kt" "$DIRA/BotonEnAndroidTest.kt" "$DIRA/Dobles.kt" \
           "$DIRM/Puertas.kt" "$DIRM/EntradaConGoogle.kt" "$DIRM/Bienvenida.kt" "$DIRM/Inicio.kt"; do
    cmp -s "$PROY/$t" "$L04/$t" || cambiados="$cambiados $PROY/$t"
  done
  [ -z "$cambiados" ] \
    && si "Andamiaje: las pruebas de la lección 04, sus dobles, Puertas.kt, EntradaConGoogle.kt, Bienvenida.kt e Inicio.kt son idénticos a los de la solución de la 04 (11 archivos comparados)" \
    || no "Estos archivos ya no son los de la lección 04 y no se tocan:$cambiados"
else
  no "No encontré la solución de la lección 04 ($L04): sin ella no puedo comparar que lo de la 04 siga igual"
