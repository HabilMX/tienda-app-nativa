#!/usr/bin/env bash
# Revisa la lección 05. Sin más, en el nivel SIMULADO: corre las pruebas en tu computadora
# (./gradlew testDebugUnitTest), sin emulador, sin navegador, sin cuenta y sin red hacia Microsoft, Google ni
# Firebase, y lee el conteo de los informes de resultados (XML). Con la palabra «instrumentado» corre ADEMÁS
# las pruebas instrumentadas dentro de un emulador o teléfono conectado.
# Nivel simulado. SÍ revisa, corriendo las pruebas de EntradaConMicrosoftTest (le dan a tu EntradaConMicrosoft
#   una puerta de mentira, la de DoblesDeMicrosoft.kt, y miran qué le pidió y qué contestó): que un toque abra
#   el navegador una sola vez y con el proveedor microsoft.com; que el nombre sea el que contesta la puerta;
#   que al tocar el botón se pregunte primero por una entrada a medias y, si la hay, no se abra el navegador;
#   que retomar() regrese quién entró si quedó algo a medias y null si no, sin abrir nunca el navegador; que
#   una entrada a medias que terminó en colisión o en falla se retome con ese resultado; y que la cancelación
#   (FirebaseAuthWebException con ERROR_WEB_CONTEXT_CANCELED), la colisión de cuenta
#   (FirebaseAuthUserCollisionException con ERROR_ACCOUNT_EXISTS_WITH_DIFFERENT_CREDENTIAL) y el error (otra
#   falla web, otra colisión u otra excepción) den tres resultados distintos.
# SÍ revisa, corriendo las pruebas de RecorridoConMicrosoftTest (dibujan Tienda en memoria y tocan los
#   botones): que los dos botones estén y cada uno llame a su entrada; que con tu EntradaConMicrosoft y la
#   puerta de mentira el botón «Entrar con Microsoft» lleve al inicio con el nombre; que cancelación, error y
#   colisión dejen en pantalla cada uno su mensaje, sin pasar al inicio; y que, al dibujarse la app con una
#   entrada a medias, llegue al inicio sin tocar nada, y sin ella se quede en la bienvenida.
# SÍ revisa, corriendo las pruebas de ArranqueConMicrosoftTest (abren MainActivity, como al tocar el ícono):
#   que por ese camino la pantalla de entrada muestre los dos botones; y que la entrada que arma
#   MainActivity.crearEntradaConMicrosoft, con la puerta de mentira que le pasa la prueba, pida microsoft.com.
# SÍ revisa que las pantallas y el botón de Google sigan como en la lección 04: corre sus 20 pruebas
#   (EntradaConGoogleTest, RecorridoTest y ArranqueTest) y compara, byte por byte, esos archivos de pruebas,
#   sus dobles, Puertas.kt, EntradaConGoogle.kt, Bienvenida.kt e Inicio.kt contra los de la solución de la 04.
#   PantallaEntrada.kt y Tienda.kt SÍ cambiaron respecto a la 04 (traen el segundo botón, que viene dado): esos
#   dos se comparan contra los de la solución de esta lección.
# SÍ busca (5.1), en todos los archivos de texto del proyecto y en respuestas/05.md, sin contar build/,
#   .gradle/ ni .kotlin/: un texto con FORMA de clave de cliente de Entra (3 caracteres, un dígito, «Q~» y de
#   31 a 34 caracteres más) y un texto que NOMBRE un secreto de cliente (client_secret, clientSecret). Antes
#   de buscar, siembra una clave inventada en un archivo temporal fuera del proyecto y exige encontrarla: si
#   la búsqueda no la ve, lo dice en rojo en lugar de dar un «no hay». Nunca imprime lo que encontró: solo el
#   archivo y el número de línea.
# PRESENCIA TEXTUAL (busca palabras en tus archivos; no los ejecuta y no valida que el código haga lo que
#   dicen; en los .kt las líneas de comentario no cuentan): que EntradaConMicrosoft.kt nombre OAuthProvider,
#   "microsoft.com" y pendiente(); que Armado.kt nombre EntradaConMicrosoft( ; que MainActivity.kt arme con
#   Armado.kt y le pase la pieza a Tienda (además se compara que ese archivo sea idéntico en inicio/ y en
#   solucion/); que ningún .kt de la app nombre MicrosoftSinConectar, una pieza de pruebas, el
#   token de acceso de Microsoft (accessToken, OAuthCredential) ni traiga escrito un ID de cliente de Google;
#   que ningún archivo de código del proyecto traiga un texto con forma de ID de aplicación de Entra (un
#   GUID); que el catálogo diga las versiones de la serie; que el .gitignore traiga google-services.json; y
#   que respuestas/05.md traiga pegado el rojo del «Rompe uno a propósito». Y le pregunta a git si rastrea
#   algún google-services.json en el repo.
# Nivel instrumentado (solo si lo pides). SÍ revisa, corriendo MicrosoftEnAndroidTest y BotonEnAndroidTest
#   dentro de Android (./gradlew connectedDebugAndroidTest): que ahí, con tu EntradaConMicrosoft y la misma
#   puerta de mentira, el toque en «Entrar con Microsoft» lleve al inicio con el nombre; que cancelación,
#   error y colisión muestren su mensaje; que una entrada a medias que contesta el doble lleve al inicio sin
#   tocar nada; y que las 4 pruebas del botón de Google de la 04 sigan en verde. Instala en el dispositivo la
#   app y su app de pruebas.
# NO revisa, en ningún nivel: el navegador, a Microsoft ni a Firebase. La clase que sí abre el navegador
#   (NavegadorConFirebase, en PuertaDelNavegador.kt) solo se ejecuta en una parte: al abrir MainActivity en
#   las pruebas pregunta por una entrada a medias y Firebase contesta, en tu computadora, que no hay ninguna.
#   Abrir el navegador NO se ejecuta; solo se compara que el archivo siga igual al de la lección. «Retomar»
#   aquí es el doble diciendo que quedó algo a medias: ninguna prueba cierra la app con el navegador abierto.
#   Ninguna prueba lee los parámetros de la solicitud: select_account es una recomendación de la lección y
#   solo se avisa si falta. Que onCreate le pase a Tienda lo que arma Armado.kt no lo ve ninguna prueba: lo
#   respalda que MainActivity.kt sea idéntico en inicio/ y en solucion/. La búsqueda de la clave ve archivos,
#   y con una sola forma: no ve tu terminal, tus capturas, tu portapapeles ni el historial de git, y una
#   clave con otra forma se le pasa. Por eso no demuestra que tu app esté registrada en Entra, que la
#   dirección de retorno sea la exacta, que la clave en Firebase sea la vigente ni que tú puedas entrar: eso
#   es el nivel real, una vez, a mano. Ni califica tu tabla del registro (5.1), tu tabla de comparación (5.3)
#   ni tu lista del 5.4. Enlazar los dos proveedores es la lección 06.
# Solo lee tu código y tus archivos: no los cambia. Gradle escribe sus resultados en build/, que no se sube.
# Uso:  ./verifica                          revisa tu trabajo en inicio/, nivel simulado
#       ./verifica solucion                 revisa la solución de referencia. En un clon limpio sale en ROJO:
#                                           google-services.json no se sube, y sin él el proyecto no compila.
#                                           Copia tu archivo a solucion/app/ (sigue ignorado) y retíralo al terminar.
#       ./verifica inicio instrumentado     además corre el nivel instrumentado (pide un emulador abierto o un
#       ./verifica solucion instrumentado   teléfono conectado; si no hay, sale en rojo y lo dice)
set -uo pipefail
cd "$(dirname "$0")"
PROY="${1:-inicio}"
ok=0
si() { echo "✅ $1"; }
no() { echo "❌ $1"; ok=1; }
nota() { echo "ℹ️  $1"; }

NIVEL="${2:-simulado}"
case "$PROY" in
  inicio|solucion) ;;
  *) echo "Uso: ./verifica [inicio|solucion] [instrumentado]"; exit 2 ;;
esac
case "$NIVEL" in
  simulado|instrumentado) ;;
  *) echo "Uso: ./verifica [inicio|solucion] [instrumentado]"; exit 2 ;;
esac
PAQ="mx.habil.ejemplo.tienda"
DIRM="app/src/main/java/mx/habil/ejemplo/tienda"
DIRP="app/src/test/java/mx/habil/ejemplo/tienda"
DIRA="app/src/androidTest/java/mx/habil/ejemplo/tienda"
MAIN="$PROY/app/src/main"
JSON="$PROY/app/google-services.json"
L04="../04-entrar-con-google/solucion"
RESP=../../respuestas/05.md
DIRX="$PROY/app/build/test-results/testDebugUnitTest"
XMLG="$DIRX/TEST-$PAQ.EntradaConGoogleTest.xml"
XMLR="$DIRX/TEST-$PAQ.RecorridoTest.xml"
XMLA="$DIRX/TEST-$PAQ.ArranqueTest.xml"
XMLM="$DIRX/TEST-$PAQ.EntradaConMicrosoftTest.xml"
XMLRM="$DIRX/TEST-$PAQ.RecorridoConMicrosoftTest.xml"
XMLAM="$DIRX/TEST-$PAQ.ArranqueConMicrosoftTest.xml"
MARCA_ROMPE="quedó una entrada a medias y retomar() no la recogió"
echo "Revisando $PROY/ — nivel simulado (sin emulador, sin navegador, sin cuenta, sin hablar con Microsoft ni con Firebase)"

# --- Andamiaje · lo que el proyecto ya trae -------------------------------------------------
grep -q '^org.gradle.jvmargs=.*-Xmx4g' "$PROY/gradle.properties" 2>/dev/null \
  && si "Andamiaje: gradle.properties le da 4 GB de memoria a Gradle (-Xmx4g)" \
  || no "gradle.properties ya no trae -Xmx4g: regresa la línea  org.gradle.jvmargs=-Xmx4g -Dfile.encoding=UTF-8"
# Se compara inicio/ contra solucion/ sin importar cuál de los dos se esté revisando: son los mismos archivos.
if [ -d inicio ] && [ -d solucion ]; then
  cambiados=""
  for t in "$DIRP/EntradaConMicrosoftTest.kt" "$DIRP/RecorridoConMicrosoftTest.kt" "$DIRP/ArranqueConMicrosoftTest.kt" \
           "$DIRP/DoblesDeMicrosoft.kt" "$DIRP/AppDePruebas.kt" "app/src/test/resources/robolectric.properties" \
           "$DIRA/MicrosoftEnAndroidTest.kt" "$DIRA/DoblesDeMicrosoft.kt" \
           "$DIRM/PuertaDelNavegador.kt" "$DIRM/PantallaEntrada.kt" "$DIRM/Tienda.kt" "$DIRM/MainActivity.kt" "$DIRM/Entrada.kt"; do
